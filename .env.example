# Copier en .env pour personnaliser le déploiement. En Docker, le mode et les
# modèles se règlent dans l’interface. Les options réseau ci-dessous sont transmises par Compose.
# RAGATOR_BIND_ADDRESS=127.0.0.1
# RAGATOR_PORT=3210
# Accès réseau privé : choisir l’adresse IP de l’hôte et fournir un mot de passe avant le démarrage.
# RAGATOR_PASSWORD=
# RAGATOR_HOSTS=ragator.example.org
# Passerelle Caddy + authentik (facultative). Secret dédié, généré avec openssl rand -hex 32.
# RAGATOR_PUBLIC_URL=https://ragator.example.org
# RAGATOR_GATEWAY_SECRET=
# RAGATOR_GATEWAY_TRUST=1

# Les paramètres suivants s’appliquent aux commandes npm lancées depuis le dépôt.

# Base PostgreSQL + ParadeDB (npm run db:up la lance sur 127.0.0.1:15432)
DATABASE_URL=postgres://ragator:ragator@127.0.0.1:15432/ragator

# Dossier des fichiers video--<id>.json
CORPUS_DIR=./corpus

# Mode : local (serveurs de modèles sur la machine) ou openrouter. Vide : openrouter si une clé est donnée,
# sinon aucun modèle (recherche par mots seulement, réponses faites d'extraits).
# RAGATOR_MODE=local

# Mode local : adresses des serveurs (défaut : services llm, embed et juge de la pile Docker).
# LOCAL_LLM_URL=http://127.0.0.1:8080/v1
# LOCAL_EMBEDDING_URL=http://127.0.0.1:8081/v1
# LOCAL_JUDGE_URL=http://127.0.0.1:8000
# Places et contexte de llama-server (-np, -c), si différents de 8 et 81920.
# LOCAL_LLM_PARALLEL=8
# LOCAL_LLM_CONTEXT=81920

# Mode openrouter : clé (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Facultatif : modèle des réponses (défaut : openai/gpt-6-luna) et de l'enrichissement des passages.
# OPENROUTER_LLM_MODEL=
# OPENROUTER_ENRICH_MODEL=

# Facultatif : probabilité minimale d'une vidéo retenue pour une question générale (défaut : 0.3).
# JUDGE_THRESHOLD=0.3   (défaut 0.4 en mode local)

# Tests d'intégration : base dédiée, créée automatiquement (nom terminé par _test)
# DATABASE_URL_TEST=postgres://ragator:ragator@127.0.0.1:15432/ragator_test
